// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MaterialType {
  SIMPLE
  KIT
}

enum PoliticalTag {
  PAULO_CASE
  PEDRO_LUCAS
  ORLEANS_BRANDAO
}

model Material {
  id                String         @id @default(uuid())
  name              String
  type              MaterialType   @default(SIMPLE)
  tags              PoliticalTag[]
  currentQuantity   Int            @default(0)
  referenceQuantity Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  entries         StockEntry[]
  withdrawals     Withdrawal[]
  returns         Return[]
  assemblies      KitAssembly[]
  recipeOf        KitComponent[] @relation("KitToComponents")
  usedAsComponent KitComponent[] @relation("ComponentToKits")
}

model StockEntry {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Int
  createdAt  DateTime @default(now())
}

model Occasion {
  id   String @id @default(uuid())
  name String @unique

  withdrawals Withdrawal[]
  returns     Return[]
}

model Withdrawal {
  id                String   @id @default(uuid())
  materialId        String
  material          Material @relation(fields: [materialId], references: [id])
  quantity          Int
  personId          String
  person            Person   @relation(fields: [personId], references: [id])
  occasionId        String
  occasion          Occasion @relation(fields: [occasionId], references: [id])
  withdrawalGroupId String?
  createdAt         DateTime @default(now())
}

model PoliticalReference {
  id   String @id @default(uuid())
  name String @unique

  people Person[]
}

model Person {
  id                   String             @id @default(uuid())
  name                 String             @unique
  contact              String?
  politicalReferenceId String
  politicalReference   PoliticalReference @relation(fields: [politicalReferenceId], references: [id])
  createdAt            DateTime           @default(now())

  withdrawals Withdrawal[]
}

model Return {
  id         String   @id @default(uuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id])
  quantity   Int
  createdAt  DateTime @default(now())
}

model KitComponent {
  id             String   @id @default(uuid())
  kitId          String
  kit            Material @relation("KitToComponents", fields: [kitId], references: [id])
  componentId    String
  component      Material @relation("ComponentToKits", fields: [componentId], references: [id])
  quantityPerKit Int
}

model KitAssembly {
  id                String   @id @default(uuid())
  kitId             String
  kit               Material @relation(fields: [kitId], references: [id])
  quantityAssembled Int
  createdAt         DateTime @default(now())
}
